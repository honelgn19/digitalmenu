{
  "version": 2,
  "builds": [
    {
      "src": "digitalmenu/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "digitalmenu/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "digitalmenu/server.js"
    },
    {
      "src": "/menu",
      "dest": "digitalmenu/index.html"
    },
    {
      "src": "/",
      "dest": "digitalmenu/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "digitalmenu/$1"
    }
  ]
}
