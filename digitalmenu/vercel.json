{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/menu",
      "dest": "index.html"
    },
    {
      "src": "/",
      "dest": "login.html"
    },
    {
      "src": "/(.*)",
      "dest": "$1"
    }
  ]
}
